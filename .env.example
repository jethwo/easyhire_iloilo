# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# DB_ENGINE picks the backend: postgresql (default) or mysql / mariadb.
# Leave DB_PORT unset to take the backend's default (5432 / 3306).
# See DATABASE.md before switching — MySQL/MariaDB needs its time zone
# tables loaded or the analytics charts come back empty.
DB_ENGINE=postgresql
DB_NAME=easyhire
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# MySQL / MariaDB credentials. Read only when DB_ENGINE=mysql (or mariadb),
# and each one falls back to the matching DB_* key above when unset. Keeping
# them separate means both servers can be configured at once and switching
# backends is a one-line DB_ENGINE change.
MYSQL_DB_NAME=easyhire
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=yourmariadbpassword
MYSQL_DB_PORT=3306

# Redis (for Celery + Channels)
REDIS_URL=redis://localhost:6379/0

# Email (for notifications, password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=yourpassword
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@easyhire.ph

# Media / static (change for production cloud storage)
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/
